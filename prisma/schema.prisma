generator client {
  provider = "prisma-client"
  // Generate my Client and Project types
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id              Int     @id @default(autoincrement())
  office_number   String  @db.VarChar(3)
  idir            String? @unique @db.Citext
  first_name      String  @db.VarChar(30)
  alternate_name  String? @db.VarChar(30)
  last_name       String  @db.VarChar(30)
  employee_id     String? @unique @db.VarChar(6)
  program_area_id Int
  job_title_id    Int?
  notes           String? @db.VarChar(2000)

  assigned_office Office      @relation(fields: [office_number], references: [office_number])
  program_area    ProgramArea @relation(fields: [program_area_id], references: [id])
  job_title       JobTitle?   @relation(fields: [job_title_id], references: [id])

  workspace Workspace?
}

model Branch {
  id   Int    @id @default(autoincrement())
  name String @unique @db.Citext

  program_areas ProgramArea[]
}

model ProgramArea {
  id        Int    @id @default(autoincrement())
  name      String @db.Citext
  branch_id Int

  branch Branch @relation(fields: [branch_id], references: [id])

  employees               Employee[]
  program_area_job_titles ProgramAreaJobTitle[]

  // Names are unique WITHIN a branch (same program area name can exist under different branches)
  @@unique([branch_id, name])
}

model JobTitle {
  id   Int    @id @default(autoincrement())
  name String @unique @db.Citext

  program_area_job_titles ProgramAreaJobTitle[]
  employees               Employee[]
}

model ProgramAreaJobTitle {
  program_area_id Int
  job_title_id    Int

  program_area ProgramArea @relation(fields: [program_area_id], references: [id])
  job_title    JobTitle    @relation(fields: [job_title_id], references: [id])

  @@id([program_area_id, job_title_id])
}

model Office {
  office_number          String @id @db.VarChar(3)
  office_name            String @db.VarChar(35)
  type_id                Int
  client_service_type_id Int
  address                String @db.VarChar(45)
  city                   String @db.VarChar(20)
  postal_code            String @db.VarChar(7)

  office_type         OfficeType          @relation(fields: [type_id], references: [id])
  client_service_type TypeOfClientService @relation(fields: [client_service_type_id], references: [id])

  employees  Employee[]
  workspaces Workspace[]
}

model OfficeType {
  id   Int    @id @default(autoincrement())
  name String @unique @db.Citext

  offices Office[]
}

model TypeOfClientService {
  id   Int    @id @default(autoincrement())
  name String @unique @db.Citext

  offices Office[]
}

model Workspace {
  office_number    String  @db.VarChar(3)
  workspace_number String  @db.VarChar(4)
  category_id      Int
  notes            String? @db.VarChar(2000)

  // makes non-null employee IDs unique to ensure one employee cannot occupy multiple workspaces
  // Also, this references employee's internal id not employee_id
  employee_id Int? @unique

  is_on_hold Boolean @default(false)

  category          WorkspaceCategory @relation(fields: [category_id], references: [id])
  assigned_office   Office            @relation(fields: [office_number], references: [office_number])
  assigned_employee Employee?         @relation(fields: [employee_id], references: [id])

  @@id([office_number, workspace_number]) // composite primary key
}

model WorkspaceCategory {
  id   Int    @id @default(autoincrement())
  name String @unique @db.Citext

  workspaces Workspace[]
}

model Workstation {
  asset_tag String  @id @db.Citext
  notes     String? @db.VarChar(2000)
}
