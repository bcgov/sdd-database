{
  "name": "sdd-database",
  "version": "0.0.13",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",

    "pf:dev": "oc -n a6d989-dev port-forward pod/crunchy-postgres-pgbouncer-57b8bf579-4sw2t 5432:5432",
    "pf:test": "oc -n a6d989-test port-forward pod/crunchy-postgres-pgbouncer-57b8bf579-b2m4v 5433:5432",

    "localhost:dev": "dotenv -e .env.development.local -- next dev",
    "localhost:test": "dotenv -e .env.test.local -- next dev",

    "studio:dev": "dotenv -e .env.development.local -- npx prisma studio --port 5555",
    "studio:test": "dotenv -e .env.test.local -- npx prisma studio --port 5556",

    "seed:dev": "npx dotenv -e .env.development.local -- prisma db seed",
    "seed:test": "npx dotenv -e .env.test.local -- prisma db seed",

    "migrate:dev": "npx dotenv -e .env.development.local -- npx prisma migrate dev --name",
    "migrate:test": "npx dotenv -e .env.test.local -- npx prisma migrate deploy"
  },
  "dependencies": {
    "@bcgov/design-system-react-components": "^0.5.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@prisma/client": "^6.17.1",
    "next": "15.5.5",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.5",
    "postcss": "^8",
    "prisma": "^6.17.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
