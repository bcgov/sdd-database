{
  "name": "sdd-database",
  "version": "0.0.29",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pf:dev": "oc -n a6d989-dev port-forward svc/crunchy-postgres-pgbouncer 5432:5432",
    "pf:test": "oc -n a6d989-test port-forward svc/crunchy-postgres-pgbouncer 5433:5432",
    "localhost:dev": "dotenv -e .env.development.local -- next dev",
    "localhost:test": "dotenv -e .env.test.local -- next dev",
    "studio:dev": "dotenv -e .env.development.local -- npx prisma studio --port 5555",
    "studio:test": "dotenv -e .env.test.local -- npx prisma studio --port 5556",
    "reset:dev": "npx dotenv -e .env.development.local -- npx prisma migrate reset",
    "reset:test": "npx dotenv -e .env.test.local -- npx prisma migrate reset",
    "seed:dev": "npx dotenv -e .env.development.local -- prisma db seed",
    "seed:test": "npx dotenv -e .env.test.local -- prisma db seed",
    "migrate:dev": "npx dotenv -e .env.development.local -- npx prisma migrate dev --name",
    "migrate:test": "npx dotenv -e .env.test.local -- npx prisma migrate deploy",
    "generate:dev": "npx dotenv -e .env.development.local -- npx prisma generate",
    "generate:test": "npx dotenv -e .env.test.local -- npx prisma generate"
  },
  "dependencies": {
    "@bcgov/design-system-react-components": "^0.7.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "next": "16.2.3",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.2.3",
    "exceljs": "^4.4.0",
    "postcss": "^8",
    "prisma": "^7.7.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6"
  }
}
